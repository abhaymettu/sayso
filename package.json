{
  "name": "sayso",
  "version": "0.1.0",
  "description": "Your agent can see your Claude Code sessions and answer their questions. Commands that look destructive wait for a yes signed on your phone, even with permissions bypassed.",
  "type": "module",
  "license": "MIT",
  "author": "Abhay Mettu",
  "repository": "github:abhaymettu/sayso",
  "homepage": "https://abhaymettu.github.io/sayso/",
  "bin": { "sayso": "bin/sayso.mjs" },
  "engines": { "node": ">=20" },
  "files": ["bin", "src", "hooks", "skills", ".claude-plugin", "README.md", "AGENTS.md", "LICENSE"],
  "scripts": {
    "test": "node --test --test-timeout=1800000 --test-concurrency=4 test/*.test.mjs",
    "test:unit": "node --test test/unit.test.mjs test/classify.test.mjs",
    "test:e2e": "node --test --test-timeout=1800000 --test-concurrency=2 test/e2e.test.mjs test/attacks.test.mjs test/plugin.test.mjs",
    "test:live": "node test/live.mjs",
    "test:tunnel": "node test/tunnel.mjs",
    "bench": "node bench/latency.mjs",
    "test:smoke": "node test/smoke.mjs",
    "test:sdk": "npm i --no-save --omit=optional --no-audit --no-fund @anthropic-ai/claude-agent-sdk@0.3.316 && node test/sdk-host.mjs",
    "probe": "node test/probe-hooks.mjs"
  }
}
