{
  "description": "sayso: holds risky tool calls until your agent or you answer, in every permission mode.",
  "hooks": {
    "PreToolUse": [{"hooks":[{"type":"command","command":"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh","args":["gate"],"timeout":3600,"onFailure":"block","statusMessage":"sayso: waiting for your say-so (Esc to cancel)"}]}],
    "PermissionRequest": [{"hooks":[{"type":"command","command":"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh","args":["gate"],"timeout":3600,"onFailure":"block"}]}],
    "SessionStart": [{"hooks":[{"type":"command","command":"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh","args":["report"],"async":true}]}],
    "UserPromptSubmit": [{"hooks":[{"type":"command","command":"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh","args":["report"],"async":true}]}],
    "PostToolUse": [{"hooks":[{"type":"command","command":"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh","args":["report"],"async":true}]}],
    "PostToolUseFailure": [{"hooks":[{"type":"command","command":"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh","args":["report"],"async":true}]}],
    "Notification": [{"hooks":[{"type":"command","command":"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh","args":["report"],"async":true}]}],
    "StopFailure": [{"hooks":[{"type":"command","command":"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh","args":["report"],"async":true}]}],
    "SessionEnd": [{"hooks":[{"type":"command","command":"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh","args":["report"],"async":true}]}],
    "Stop": [{ "hooks": [
      {"type":"command","command":"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh","args":["report"],"async":true},
      {"type":"command","command":"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh","args":["wake"],"async":true,"asyncRewake":true,"timeout":86400}
    ] }]
  }
}
