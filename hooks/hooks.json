{
  "description": "sayso: holds risky tool calls until your agent or you answer, in every permission mode.",
  "hooks": {
    "PreToolUse": [{ "hooks": [{ "type": "command", "command": "/usr/bin/env -i PATH=/usr/bin:/bin:/usr/sbin:/sbin HOME=\"$HOME\" CLAUDE_PID=\"$CLAUDE_PID\" CLAUDE_CODE_ENTRYPOINT=\"$CLAUDE_CODE_ENTRYPOINT\" CLAUDE_CODE_SESSION_ATTENDED=\"$CLAUDE_CODE_SESSION_ATTENDED\" CLAUDE_CONFIG_DIR=\"$CLAUDE_CONFIG_DIR\" /bin/sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" gate", "timeout": 3600, "onFailure": "block", "statusMessage": "sayso: waiting for your say-so (Esc to cancel)" }] }],
    "PermissionRequest": [{ "hooks": [{ "type": "command", "command": "/usr/bin/env -i PATH=/usr/bin:/bin:/usr/sbin:/sbin HOME=\"$HOME\" CLAUDE_PID=\"$CLAUDE_PID\" CLAUDE_CODE_ENTRYPOINT=\"$CLAUDE_CODE_ENTRYPOINT\" CLAUDE_CODE_SESSION_ATTENDED=\"$CLAUDE_CODE_SESSION_ATTENDED\" CLAUDE_CONFIG_DIR=\"$CLAUDE_CONFIG_DIR\" /bin/sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" gate", "timeout": 3600, "onFailure": "block" }] }],
    "SessionStart": [{ "hooks": [{ "type": "command", "command": "/usr/bin/env -i PATH=/usr/bin:/bin:/usr/sbin:/sbin HOME=\"$HOME\" CLAUDE_PID=\"$CLAUDE_PID\" CLAUDE_CODE_ENTRYPOINT=\"$CLAUDE_CODE_ENTRYPOINT\" CLAUDE_CODE_SESSION_ATTENDED=\"$CLAUDE_CODE_SESSION_ATTENDED\" CLAUDE_CONFIG_DIR=\"$CLAUDE_CONFIG_DIR\" /bin/sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" report", "async": true }] }],
    "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "/usr/bin/env -i PATH=/usr/bin:/bin:/usr/sbin:/sbin HOME=\"$HOME\" CLAUDE_PID=\"$CLAUDE_PID\" CLAUDE_CODE_ENTRYPOINT=\"$CLAUDE_CODE_ENTRYPOINT\" CLAUDE_CODE_SESSION_ATTENDED=\"$CLAUDE_CODE_SESSION_ATTENDED\" CLAUDE_CONFIG_DIR=\"$CLAUDE_CONFIG_DIR\" /bin/sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" report", "async": true }] }],
    "PostToolUse": [{ "hooks": [{ "type": "command", "command": "/usr/bin/env -i PATH=/usr/bin:/bin:/usr/sbin:/sbin HOME=\"$HOME\" CLAUDE_PID=\"$CLAUDE_PID\" CLAUDE_CODE_ENTRYPOINT=\"$CLAUDE_CODE_ENTRYPOINT\" CLAUDE_CODE_SESSION_ATTENDED=\"$CLAUDE_CODE_SESSION_ATTENDED\" CLAUDE_CONFIG_DIR=\"$CLAUDE_CONFIG_DIR\" /bin/sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" report", "async": true }] }],
    "PostToolUseFailure": [{ "hooks": [{ "type": "command", "command": "/usr/bin/env -i PATH=/usr/bin:/bin:/usr/sbin:/sbin HOME=\"$HOME\" CLAUDE_PID=\"$CLAUDE_PID\" CLAUDE_CODE_ENTRYPOINT=\"$CLAUDE_CODE_ENTRYPOINT\" CLAUDE_CODE_SESSION_ATTENDED=\"$CLAUDE_CODE_SESSION_ATTENDED\" CLAUDE_CONFIG_DIR=\"$CLAUDE_CONFIG_DIR\" /bin/sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" report", "async": true }] }],
    "Notification": [{ "hooks": [{ "type": "command", "command": "/usr/bin/env -i PATH=/usr/bin:/bin:/usr/sbin:/sbin HOME=\"$HOME\" CLAUDE_PID=\"$CLAUDE_PID\" CLAUDE_CODE_ENTRYPOINT=\"$CLAUDE_CODE_ENTRYPOINT\" CLAUDE_CODE_SESSION_ATTENDED=\"$CLAUDE_CODE_SESSION_ATTENDED\" CLAUDE_CONFIG_DIR=\"$CLAUDE_CONFIG_DIR\" /bin/sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" report", "async": true }] }],
    "StopFailure": [{ "hooks": [{ "type": "command", "command": "/usr/bin/env -i PATH=/usr/bin:/bin:/usr/sbin:/sbin HOME=\"$HOME\" CLAUDE_PID=\"$CLAUDE_PID\" CLAUDE_CODE_ENTRYPOINT=\"$CLAUDE_CODE_ENTRYPOINT\" CLAUDE_CODE_SESSION_ATTENDED=\"$CLAUDE_CODE_SESSION_ATTENDED\" CLAUDE_CONFIG_DIR=\"$CLAUDE_CONFIG_DIR\" /bin/sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" report", "async": true }] }],
    "SessionEnd": [{ "hooks": [{ "type": "command", "command": "/usr/bin/env -i PATH=/usr/bin:/bin:/usr/sbin:/sbin HOME=\"$HOME\" CLAUDE_PID=\"$CLAUDE_PID\" CLAUDE_CODE_ENTRYPOINT=\"$CLAUDE_CODE_ENTRYPOINT\" CLAUDE_CODE_SESSION_ATTENDED=\"$CLAUDE_CODE_SESSION_ATTENDED\" CLAUDE_CONFIG_DIR=\"$CLAUDE_CONFIG_DIR\" /bin/sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" report", "async": true }] }],
    "Stop": [{ "hooks": [
      { "type": "command", "command": "/usr/bin/env -i PATH=/usr/bin:/bin:/usr/sbin:/sbin HOME=\"$HOME\" CLAUDE_PID=\"$CLAUDE_PID\" CLAUDE_CODE_ENTRYPOINT=\"$CLAUDE_CODE_ENTRYPOINT\" CLAUDE_CODE_SESSION_ATTENDED=\"$CLAUDE_CODE_SESSION_ATTENDED\" CLAUDE_CONFIG_DIR=\"$CLAUDE_CONFIG_DIR\" /bin/sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" report", "async": true },
      { "type": "command", "command": "/usr/bin/env -i PATH=/usr/bin:/bin:/usr/sbin:/sbin HOME=\"$HOME\" CLAUDE_PID=\"$CLAUDE_PID\" CLAUDE_CODE_ENTRYPOINT=\"$CLAUDE_CODE_ENTRYPOINT\" CLAUDE_CODE_SESSION_ATTENDED=\"$CLAUDE_CODE_SESSION_ATTENDED\" CLAUDE_CONFIG_DIR=\"$CLAUDE_CONFIG_DIR\" /bin/sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" wake", "async": true, "asyncRewake": true, "timeout": 86400 }
    ] }]
  }
}
